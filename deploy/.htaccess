# privtr.ee — Apache. Copia este archivo a la raíz del sitio como .htaccess
# (necesita mod_rewrite y mod_headers activos).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; media-src 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + apex
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://privtr.ee%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.privtr\.ee$ [NC]
  RewriteRule ^ https://privtr.ee%{REQUEST_URI} [L,R=301]

  # Dominios antiguos -> privtr.ee conservando el @usuario
  RewriteCond %{HTTP_HOST} ^(www\.)?(privacidad\.me|privtree\.com)$ [NC]
  RewriteRule ^@([A-Za-z0-9_-]+)/?$ https://privtr.ee/@$1 [L,R=301]
  RewriteCond %{HTTP_HOST} ^(www\.)?(privacidad\.me|privtree\.com)$ [NC]
  RewriteRule ^ https://privtr.ee%{REQUEST_URI} [L,R=301]

  # URL antigua /u.html?u=ana -> /@ana
  RewriteCond %{QUERY_STRING} (?:^|&)u=([A-Za-z0-9_-]{2,32})(?:&|$)
  RewriteRule ^u\.html$ /@%1? [L,R=301]

  # Perfiles: /@ana servido por u.html con 200
  RewriteRule ^@([A-Za-z0-9_-]{2,32})/?$ /u.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 5 minutes"
  ExpiresByType text/css                  "access plus 1 hour"
  ExpiresByType application/javascript    "access plus 1 hour"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

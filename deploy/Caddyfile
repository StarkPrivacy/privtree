# privtr.ee — Caddy 2. TLS automático.

(seguridad) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; media-src 'self'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

# Dominios antiguos -> privtr.ee conservando el @usuario
privacidad.me, www.privacidad.me, privtree.com, www.privtree.com {
	redir /@* https://privtr.ee{uri} permanent
	redir https://privtr.ee{uri} permanent
}

www.privtr.ee {
	redir https://privtr.ee{uri} permanent
}

privtr.ee {
	root * /var/www/privtree
	import seguridad
	encode zstd gzip

	# /u.html?u=ana -> /@ana (canoniza la URL antigua)
	@viejo path /u.html
	handle @viejo {
		@conUser query u=*
		redir @conUser /@{query.u} permanent
		file_server
	}

	# Perfiles: /@ana servido por u.html con 200
	@perfil path_regexp perfil ^/@([A-Za-z0-9_-]{2,32})/?$
	handle @perfil {
		rewrite * /u.html
		file_server
	}

	@estaticoLargo path *.woff2 *.jpg *.jpeg *.png *.svg *.webp *.ico
	header @estaticoLargo Cache-Control "public, max-age=31536000, immutable"
	@css_js path *.css *.js
	header @css_js Cache-Control "public, max-age=3600, must-revalidate"
	@html path *.html /
	header @html Cache-Control "public, max-age=300, must-revalidate"

	handle {
		try_files {path} {path}/ /404.html
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
